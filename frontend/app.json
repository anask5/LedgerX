{
  "expo": {
    "name": "LedgerX",
    "slug": "ledgerx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "ledgerx",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "expo-local-authentication"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ledgerx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LedgerX needs camera access to scan receipts",
        "NSPhotoLibraryUsageDescription": "LedgerX needs photo library access to upload receipt images",
        "NSFaceIDUsageDescription": "LedgerX uses Face ID to protect your data"
      }
    },
    "android": {
      "package": "com.ledgerx.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14432745-28cb-4265-b994-799894865197"
      }
    },
    "owner": "starhazers"
  }
}
