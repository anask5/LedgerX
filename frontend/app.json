{
  "expo": {
    "name": "ReceiptWise",
    "slug": "receiptwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "receiptwise",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "expo-local-authentication"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.receiptwise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ReceiptWise needs camera access to scan receipts",
        "NSPhotoLibraryUsageDescription": "ReceiptWise needs photo library access to upload receipt images",
        "NSFaceIDUsageDescription": "ReceiptWise uses Face ID to protect your data"
      }
    },
    "android": {
      "package": "com.receiptwise.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
